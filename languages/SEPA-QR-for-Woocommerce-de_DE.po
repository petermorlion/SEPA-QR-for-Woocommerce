msgstr "SEPA-QR"

#: muxp-sepaqr.php:211
msgid "Order-ID:"
msgstr "Bestellnummer:"

#: muxp-sepaqr.php:139
msgid "Generating uncached dummy QR for 11 Euro/OrderID 11"
msgstr "Erzeuge einen Test-QR-Code für 11 Euro und Bestellnummer 11"

#: muxp-sepaqr.php:139
msgid "This is not a valid md5 hash"
msgstr "Das ist kein gültiger MD5-Hash"

#: muxp-sepaqr.php:106
msgid "Some email clients unfortunately will not show Base64 encoded images."
msgstr "Manche E-Mail-Programme können leider keine Base64-codierten Bilder anzeigen."

#: muxp-sepaqr.php:72 muxp-sepaqr.php:108
msgid "For a convenient payment scan this qr code!"
msgstr "Scanne diesen QR-Code für einen bequemen Bezahlvorgang!"

