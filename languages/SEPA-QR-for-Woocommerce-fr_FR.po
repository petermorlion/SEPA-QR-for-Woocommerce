msgstr "Peter Morlion"

#. Description of the plugin
#: muxp-sepaqr.php
msgid "Free plugin that adds a SEPA-QR Code for bank transfer payments (bacs) in the WooCommerce emails and order confirmation screen."
msgstr "Plugin gratuit qui ajoute un code SEPA-QR pour les paiements par virement bancaire (bacs) dans les emails et l'écran de confirmation de commande de WooCommerce."

#. Plugin URI of the plugin
#: muxp-sepaqr.php
msgid "https://github.com/petermorlion/SEPA-QR-for-Woocommerce"
msgstr "https://github.com/petermorlion/SEPA-QR-for-Woocommerce"

#. Plugin Name of the plugin
#: muxp-sepaqr.php
msgid "SEPA-QR-Code for Woocommerce"
msgstr "SEPA-QR-Code pour Woocommerce"

msgid "Maximum width of the QR code (in pixels)"
msgstr "Largeur maximale du code QR (en pixels)"

msgid "This will set the maximum width of the QR code in pixels. Default is 200."
msgstr "Ceci définira la largeur maximale du code QR en pixels. La valeur par défaut est 200."
